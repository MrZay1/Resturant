# Stripe (use the SAME account as your other business, or create a second account under the same login)
STRIPE_SECRET_KEY=sk_test_...
# Set to 1 to enable Stripe Tax on Checkout sessions. Stripe Tax must be activated in the Stripe dashboard first.
STRIPE_AUTOMATIC_TAX=
# Public base URL used for Stripe success/cancel redirects. Optional; defaults to https://tblnt.com in production and http://localhost:3000 in development.
SITE_URL=
# Where "Book a demo" and contact form submissions are POSTed as JSON (Airtable/Zapier/Make/Formspree/your endpoint).
# Required in production: without it the lead endpoint returns 503 rather than pretending the lead was saved.
LEAD_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>" so your automation can ignore forged posts.
LEAD_WEBHOOK_SECRET=
# Where card taps are POSTed as JSON for counting. Optional.
TAP_WEBHOOK_URL=
TAP_WEBHOOK_SECRET=
# Stripe webhook signing secret (Dashboard > Developers > Webhooks > your endpoint). Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Where completed orders are POSTed as JSON (defaults to LEAD_WEBHOOK_URL). Optional.
ORDER_WEBHOOK_URL=
# Order notification emails, sent through Resend (resend.com, free tier is plenty).
# RESEND_API_KEY   from resend.com/api-keys
# ORDER_EMAIL_FROM must be on a domain verified in Resend, e.g. orders@tblnt.com
# ORDER_EMAIL_TO   any inbox you actually read; a personal Gmail is fine to start.
# With these set, one order sends two emails: "Artwork" (the card picture plus the
# uploaded logo attached, when they reach the payment page) and "New order" (on payment).
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
